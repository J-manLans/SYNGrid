+++ b/src/syn_grid/scenario/goal/tier_chain/termination.py
@@ -0,0 +1,35 @@
+"""
+When a tier chain episode ends.
+
+STUB: it never ends the episode and passes the step's reward through. The real
+rule ends on a broken chain, a finished chain or the clock, and pays by the
+additive rule in `docs/dev/design-decisions.md`.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import TYPE_CHECKING
+
+from syn_grid.scenario.blocks.termination import EpisodeOutcome
+
+if TYPE_CHECKING:
+    from syn_grid.core.grid_world import GridWorld
+
+
+@dataclass(frozen=True)
+class TierChainTermination:
+    """Ends a tier chain episode: a broken chain, a finished chain, or the clock.
+
+    Attributes:
+        timeout_penalty: added to the held reward when the clock runs out.
+        completion_reward: added to the step's reward when the chain completes.
+    """
+
+    timeout_penalty: float
+    completion_reward: float
+
+    def evaluate(
+        self, world: GridWorld, steps_left: int, reward: float
+    ) -> EpisodeOutcome:
+        return EpisodeOutcome(terminated=False, truncated=False, reward=reward)
